# Twilio Serverless domain where inbound-parse-relay is deployed (no protocol)
TWILIO_FUNCTIONS_DOMAIN=iris-demo-2775-dev.twil.io

# Shared secret sent as X-Relay-Token to Twilio Function
RELAY_TOKEN=change-me

# Optional shared secret from SendGrid Inbound Parse URL: /inbound?token=...
SENDGRID_INBOUND_TOKEN=
