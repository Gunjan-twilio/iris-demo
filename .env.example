# Twilio Account
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your_auth_token

# API Key — Console → Account → API Keys → Create API Key (Standard)
API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_KEY_SECRET=your_api_key_secret

# TaskRouter — Console → TaskRouter → Workspaces
WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Conversations — must be the Flex Conversation Service (not a custom one)
# Console → Flex → Manage → Messaging → Conversation Service SID
CONVERSATIONS_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Voice
# Console → Voice → TwiML Apps
TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Email channel — the address tied to your SendGrid/Twilio Email integration
EMAIL_ADDRESS=support@yourdomain.com

# Airtable
# Personal access token from airtable.com/create/tokens
AIRTABLE_API_KEY=your_airtable_api_key
# From the Airtable URL: airtable.com/{BASE_ID}/...
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxxx
